  m_Script: {fileID: 11500000, guid: 186cd2a590cc804419216ed0a659c722, type: 3}
  m_Name: LinearFunction
  m_EditorClassIdentifier: Assembly-CSharp::TheoryTopic
  topicName: Functions
  parts:
  - description: "\u041B\u0438\u043D\u0435\u0439\u043D\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F
      \u2014 \u044D\u0442\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C
      \u0432\u0438\u0434\u0430 y = kx + b. \r\n    \u041A\u043E\u044D\u0444\u0444\u0438\u0446\u0438\u0435\u043D\u0442
      k \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u043D\u0430\u043A\u043B\u043E\u043D
      \u043B\u0438\u043D\u0438\u0438: \u043F\u0440\u0438 k>0 \u043B\u0438\u043D\u0438\u044F
      \u0438\u0434\u0451\u0442 \u0432\u0432\u0435\u0440\u0445, \u043F\u0440\u0438
      k<0 \u2014 \u0432\u043D\u0438\u0437. \r\n    \u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440
      b \u0441\u043C\u0435\u0449\u0430\u0435\u0442 \u043B\u0438\u043D\u0438\u044E
      \u0432\u0432\u0435\u0440\u0445 \u0438\u043B\u0438 \u0432\u043D\u0438\u0437."
    animationType: 0
  - description: "\u0415\u0441\u043B\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 k, \u043D\u0430\u043A\u043B\u043E\u043D
      \u043B\u0438\u043D\u0438\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043A\u0440\u0443\u0447\u0435. \r\n    \u0415\u0441\u043B\u0438 k < 0, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043D\u0430\u043A\u043B\u043E\u043D\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C,
      \u043A\u0430\u043A \u043B\u0438\u043D\u0438\u044F '\u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F'."
    animationType: 1
  - description: "\u0422\u0435\u043F\u0435\u0440\u044C \u0438\u0437\u043C\u0435\u043D\u0438\u043C
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 b. \r\n    \u041F\u0440\u0438
      \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0438 b \u0432\u0441\u044F
      \u043B\u0438\u043D\u0438\u044F \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E \u043E\u0441\u0438
      Y."
    animationType: 2
