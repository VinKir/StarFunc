  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 186cd2a590cc804419216ed0a659c722, type: 3}
  m_Name: LinearFunction
  m_EditorClassIdentifier: Assembly-CSharp::TheoryTopic
  topicName: Functions
  parts:
  - description: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0431\u043E\u0440\u0442, \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440!
      \u0412 \u044D\u0442\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0412\u0441\u0435\u043B\u0435\u043D\u043D\u043E\u0439
      \u043C\u0430\u0442\u0435\u0440\u0438\u044F \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u043F\u043E \u043B\u0438\u043D\u0435\u0439\u043D\u044B\u043C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044F\u043C.
      \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 - \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C
      \u0448\u0430\u0440\u043E\u043C (\u0437\u043E\u043D\u0434\u043E\u043C), \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F \u043F\u043E \u044D\u0442\u0438\u043C
      \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044F\u043C, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0440\u0435\u0441\u0443\u0440\u0441\u044B (\u0437\u0432\u0451\u0437\u0434\u044B).
      \u0412\u0441\u0451 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u043D\u0430 \u0434\u0432\u0443\u0445
      \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0430\u0445:
      k (\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0443\u0433\u043E\u043B
      \u043D\u0430\u043A\u043B\u043E\u043D\u0430) \u0438 b (\u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u0441\u0434\u0432\u0438\u0433)."
    animationType: 0
  - description: "\u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 k \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
      \u0443\u0433\u043E\u043B \u043D\u0430\u043A\u043B\u043E\u043D\u0430 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438. \r\nk > 0 (\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439):\r\n-
      \u041F\u0440\u044F\u043C\u0430\u044F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0441\u043B\u0435\u0432\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043E.\r\n-
      \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0447\u0438\u0441\u043B\u043E
      k, \u0442\u0435\u043C \u043A\u0440\u0443\u0447\u0435 \u043F\u043E\u0434\u044A\u0451\u043C.
      \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C, \u0447\u0442\u043E
      k=1 - \u044D\u0442\u043E \u043F\u043E\u043B\u043E\u0433\u0438\u0439 \u0445\u043E\u043B\u043C,
      \u0430 k=5 - \u043F\u043E\u0447\u0442\u0438 \u043E\u0442\u0432\u0435\u0441\u043D\u0430\u044F
      \u0441\u043A\u0430\u043B\u0430!"
    animationType: 1
  - description: "k < 0 (\u041E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439):\r\n-
      \u041F\u0440\u044F\u043C\u0430\u044F \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
      \u0441\u043B\u0435\u0432\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043E.\r\n-
      \u0427\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435 \u0447\u0438\u0441\u043B\u043E
      k (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, -5 \u043C\u0435\u043D\u044C\u0448\u0435
      -1), \u0442\u0435\u043C \u043A\u0440\u0443\u0447\u0435 \u0441\u043F\u0443\u0441\u043A
      \u0432\u043D\u0438\u0437."
    animationType: 2
  - description: "k = 0 (\u041D\u0443\u043B\u0435\u0432\u043E\u0439):\r\n- \u042D\u0442\u043E
      \u043E\u0441\u043E\u0431\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439!
      \u0415\u0441\u043B\u0438 k = 0, \u0442\u043E x \u0438\u0437 \u0443\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044F
      \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442, \u0438 \u043E\u043D\u043E
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432
      y = b.\r\n- \u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
      \u043F\u0440\u044F\u043C\u0430\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043D\u0435 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F.
      \u041E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0442\u043E\u0447\u043A\u0443 b \u043D\u0430
      \u043E\u0441\u0438 Y."
    animationType: 3
  - description: "\u0427\u0438\u0441\u043B\u043E b \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0432 \u043A\u0430\u043A\u043E\u0439 \u0442\u043E\u0447\u043A\u0435 \u043D\u0430\u0448\u0430
      \u043F\u0440\u044F\u043C\u0430\u044F \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442
      \u043E\u0441\u044C Y:\r\n- \u0415\u0441\u043B\u0438 b = 2, \u043F\u0440\u044F\u043C\u0430\u044F
      \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0451\u0442 \u043E\u0441\u044C Y
      \u0432 \u0442\u043E\u0447\u043A\u0435 (0, 2).\r\n- \u0415\u0441\u043B\u0438
      b = -1, \u043F\u0440\u044F\u043C\u0430\u044F \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0451\u0442
      \u043E\u0441\u044C Y \u0432 \u0442\u043E\u0447\u043A\u0435 (0, -1).\n- \u0415\u0441\u043B\u0438
      b = 0, \u043F\u0440\u044F\u043C\u0430\u044F \u043F\u0440\u043E\u0439\u0434\u0451\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u0447\u0430\u043B\u043E \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442
      (0, 0)."
    animationType: 4
